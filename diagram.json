{
  "version": 1,
  "author": "Mahasiswa KKN Hidroponik",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-c3-devkitm-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "ultrasonic", "top": -150, "left": 0, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay", "top": 80, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "pompa_indikator", "top": 150, "left": 280, "attrs": { "color": "blue" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    
    [ "esp:5V", "ultrasonic:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "ultrasonic:GND", "black", [ "v0" ] ],
    [ "esp:3", "ultrasonic:TRIG", "green", [ "v0" ] ],
    [ "esp:1", "ultrasonic:ECHO", "blue", [ "v0" ] ],
    
    [ "esp:5V", "relay:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "relay:GND", "black", [ "v0" ] ],
    [ "esp:7", "relay:IN", "orange", [ "v0" ] ],
    
    [ "esp:3V3", "relay:COM", "red", [ "v0" ] ],
    [ "relay:NO", "pompa_indikator:A", "blue", [ "v0" ] ],
    [ "esp:GND.3", "pompa_indikator:C", "black", [ "v0" ] ]
  ]
